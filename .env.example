# ---------------------------------------------------------------------------
# Event Bridge API environment
# Copy this file to apps/api/.env and replace every placeholder.
# Never commit the resulting .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173

# Neon -> Connection Details -> "Pooled connection" (used by the app at runtime)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/eventbridge?sslmode=require

# Neon -> Connection Details -> "Direct connection" (used by migrations)
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/eventbridge?sslmode=require

# Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-48-byte-base64url-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-48-byte-base64url-secret
REFRESH_EXPIRES_IN=7d

# Leave COOKIE_DOMAIN empty for localhost.
COOKIE_DOMAIN=
COOKIE_SECURE=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOG_LEVEL=info

# Neon S3-compatible object storage (reserved for portfolio uploads, Stage 8)
AWS_ENDPOINT_URL_S3=https://<storage-endpoint>.storage.<region>.aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# Neon Auth (not used; the API implements its own JWT authentication)
NEON_AUTH_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/<database>/auth
NEON_AUTH_JWKS_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/<database>/auth/.well-known/jwks.json
